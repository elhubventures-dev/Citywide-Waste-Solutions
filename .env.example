# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.citywidewastesolutions.com
NODE_ENV=development

# ─── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled connection for the app (Prisma `url`)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection for migrations (Prisma `directUrl`)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: used only by scripts/copy-db-to-neon.ts when migrating from Supabase
# SOURCE_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ─── Auth.js (admin credentials) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_long_random_secret
# Optional on Vercel (Auth.js trustHost usually covers this)
# AUTH_URL=https://www.citywidewastesolutions.com
ADMIN_EMAILS=wastesolutions80@gmail.com

# ─── Sanity CMS ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_read_token
SANITY_WEBHOOK_SECRET=your_sanity_webhook_secret

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+19050000000

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@citywidewastesolutions.com
EMAIL_ADMIN=wastesolutions80@gmail.com

# ─── Google ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key

# ─── Upstash (Rate Limiting) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ─── CRM ──────────────────────────────────────────────────────────────────────
GHL_API_KEY=your_gohighlevel_api_key
GHL_LOCATION_ID=your_ghl_location_id
